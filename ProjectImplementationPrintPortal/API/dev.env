# Copy to .env for local use. No secrets belong here: SQL uses Entra ID
# (managed identity in Azure, `az login` locally), so there is no password.

PORT=3000

# Leave SQL_SERVER empty to use the in-memory repository.
SQL_SERVER=
SQL_DATABASE=

# Optional: where the static frontend lives (defaults to ../Frontend/Public).
FRONTEND_DIR=

# Used by `npm run migrate` only: the app's managed identity to grant database access.
APP_IDENTITY=
APP_CLIENT_ID=
